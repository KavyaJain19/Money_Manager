<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/bg" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:background="@color/primary">
<TextView android:text="My Money" android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<TextView android:text="Offline • Local" android:textColor="#D1FAE5" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:orientation="vertical" android:padding="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:orientation="vertical" android:gravity="center" android:padding="18dp" android:background="@drawable/card_bg" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Current Balance" android:textColor="@color/muted" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/balance" android:text="₹0.00" android:textColor="@color/income" android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/setBalance" android:text="Set Starting Balance" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="82dp">
<TextView android:text="Income
₹0.00" android:id="@+id/income" android:gravity="center" android:textColor="@color/income" android:textStyle="bold" android:background="@drawable/card_bg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
<Space android:layout_width="10dp" android:layout_height="1dp"/>
<TextView android:text="Expense
₹0.00" android:id="@+id/expense" android:gravity="center" android:textColor="@color/expense" android:textStyle="bold" android:background="@drawable/card_bg" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
</LinearLayout>
<GridLayout android:columnCount="2" android:rowCount="2" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/addBtn" android:text="Add Transaction" android:textAllCaps="false" android:layout_width="0dp" android:layout_height="76dp" android:layout_columnWeight="1"/>
<Button android:id="@+id/friendsBtn" android:text="Friends &amp; Due" android:textAllCaps="false" android:layout_width="0dp" android:layout_height="76dp" android:layout_columnWeight="1"/>
<Button android:id="@+id/historyBtn" android:text="History" android:textAllCaps="false" android:layout_width="0dp" android:layout_height="76dp" android:layout_columnWeight="1"/>
<Button android:id="@+id/export" android:text="Export &amp; Backup" android:textAllCaps="false" android:layout_width="0dp" android:layout_height="76dp" android:layout_columnWeight="1"/>
</GridLayout>
<LinearLayout android:orientation="horizontal" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Recent Transactions" android:textSize="18sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<TextView android:id="@+id/viewAll" android:text="View all" android:textColor="@color/income" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:id="@+id/list" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="8dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
<LinearLayout android:orientation="horizontal" android:gravity="center" android:background="@color/card" android:layout_width="match_parent" android:layout_height="62dp">
<Button android:id="@+id/homeBtn" android:text="Overview" android:textAllCaps="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
<Button android:id="@+id/bottomAddBtn" android:text="Add" android:textAllCaps="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
<Button android:id="@+id/bottomFriendsBtn" android:text="Friends" android:textAllCaps="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
<Button android:id="@+id/bottomHistoryBtn" android:text="History" android:textAllCaps="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
</LinearLayout>
</LinearLayout>
